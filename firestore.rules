rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['khan.paddyrice@gmail.com'];
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll([
          'id',
          'channel',
          'createdAt',
          'customer',
          'items',
          'paymentMethod',
          'paymentStatus',
          'shippingMethod',
          'shippingFee',
          'shipping',
          'status',
          'subtotal',
          'total'
        ])
        && request.resource.data.id == orderId
        && request.resource.data.channel in ['web-cod', 'web-checkout']
        && request.resource.data.paymentMethod in ['COD', 'BANK_TRANSFER']
        && request.resource.data.paymentStatus in ['cod_pending', 'waiting_transfer']
        && request.resource.data.shippingMethod in ['standard', 'express', 'pickup']
        && request.resource.data.status == 'pending_confirmation'
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal > 0
        && request.resource.data.shippingFee is number
        && request.resource.data.shippingFee >= 0
        && request.resource.data.total is number
        && request.resource.data.total == request.resource.data.subtotal + request.resource.data.shippingFee
        && request.resource.data.shipping.method == request.resource.data.shippingMethod
        && request.resource.data.shipping.name is string
        && request.resource.data.shipping.fee == request.resource.data.shippingFee
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() >= 2
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() >= 8
        && request.resource.data.customer.address is string
        && request.resource.data.customer.address.size() >= 8;

      allow read, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'id',
          'code',
          'name',
          'slug',
          'sku',
          'price',
          'stock',
          'status',
          'featured',
          'brand',
          'category',
          'shortDescription',
          'fullDescription',
          'currency',
          'image',
          'assetPath',
          'sourceUrl',
          'applications',
          'searchText',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'name',
          'slug',
          'sku',
          'price',
          'stock',
          'status',
          'brand',
          'category',
          'currency',
          'searchText',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.slug is string
        && request.resource.data.slug.size() >= 2
        && request.resource.data.sku is string
        && request.resource.data.sku.size() >= 2
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'sku',
          'price',
          'stock',
          'status',
          'featured',
          'brand',
          'category',
          'shortDescription',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.sku is string
        && request.resource.data.sku.size() >= 2
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0;
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name',
          'count',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'count',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.count is number
        && request.resource.data.count >= 0;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
